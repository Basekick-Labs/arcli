/arcli
/arcli.exe
/dist/

# Test binaries
*.test
*.out

# IDE
.idea/
.vscode/
*.swp

# Claude Code local-only state. CLAUDE.md is local guidance, not a repo
# artifact, so it stays out of the tree.
.claude/CLAUDE.md
.claude/settings.local.json
.claude/worktrees/

# macOS
.DS_Store

# Coverage
coverage.txt
coverage.html

# Local implementation plans (see .claude/CLAUDE.md)
/docs/progress/

# GoReleaser before-hook output (man pages + completions); see .goreleaser.yaml
/.gen/

# Cloudflare CLI cache; carries the account id. Never belongs in this repo,
# but wrangler creates it in whatever directory it is run from.
/.wrangler/
